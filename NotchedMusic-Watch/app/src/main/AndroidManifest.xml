<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wear-OS-App (Zielgerät: TicWatch 5 Pro) -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Dauerhafte Wiedergabe: Der Spieler lebt in einem Vordergrund-Service, damit die Musik
         weiterläuft, wenn die Activity längst zu ist. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="de.notchedmusic.watch.WatchApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotchedMusic">

        <!-- Wear-OS-Framework ist optional (App läuft autark, ohne Phone-App) -->
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Pflicht für Data-Layer-Dienste: Der Play-Dienste-Resolver prüft beide Einträge. -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="com.google.android.wearable.version"
            android:value="2" />

        <activity
            android:name="de.notchedmusic.watch.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Besitzter Spieler: ExoPlayer + Notch-Filter + MediaSession. Andere Apps (und die
             eigene UI als Fernbedienung) finden ihn über diese Action. -->
        <service
            android:name="de.notchedmusic.watch.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Empfängt Musikdateien von der Phone-App über die Wear Data Layer und legt sie im
             privaten Musik-Ordner ab. `enabled="false"`: Der Empfang ist standardmäßig zu und wird
             von `SyncEmpfang` eingeschaltet, solange die App offen ist oder Daten eintreffen. Sonst
             weckt jede Data-Layer-Sendung den Uhr-Prozess. -->
        <service
            android:name="de.notchedmusic.watch.data.MusicTransferReceiver"
            android:enabled="false"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/music" />
            </intent-filter>
            <!-- Nur die beiden Pfade, die die Phone-App wirklich als Nachricht schickt. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/music" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/sync" />
            </intent-filter>
        </service>

        <!-- Empfängt Statistik-Anfragen und ACKs der Phone-App. Ebenfalls nur aktiv, wenn
             `SyncEmpfang` den Empfang geöffnet hat. -->
        <service
            android:name="de.notchedmusic.watch.data.StatisticsTransferReceiver"
            android:enabled="false"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/stats" />
            </intent-filter>
        </service>

        <!-- Empfängt Filter-Profile von der Phone-App (JSON über die Wear Data Layer); ebenfalls
             nur aktiv, wenn `SyncEmpfang` den Empfang geöffnet hat. -->
        <service
            android:name="de.notchedmusic.watch.playback.PhoneFilterReceiver"
            android:enabled="false"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/filter" />
            </intent-filter>
        </service>
    </application>

</manifest>
